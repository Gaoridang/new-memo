{
  "expo": {
    "name": "new-memo",
    "slug": "new-memo",
    "scheme": "newmemo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.newmemo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.newmemo"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://new-memo-becomecoseco.expo.app/"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5282476-bce9-4526-8e35-ee9a9452a00e"
      }
    },
    "owner": "becomecoseco"
  }
}
